{
  "manifest_version": 3,
  "name": "AI Code Review",
  "version": "1.0.0",
  "description": "AI-powered code review for GitHub",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabCapture"
  ],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_title": "AI Code Review",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content-script.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; style-src 'self'"
  }
}
